# En-têtes HTTP pour Cloudflare Pages (équivalent du netlify.toml).
# Ce fichier doit se trouver à la racine du dossier publié (maquette/).

# Les visuels et vidéos portent un nom stable : cache long.
# Si une image change, renommer le fichier (ex. p-mt07-2024-v2.webp).
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

# Le JS contient le catalogue et les prix : il doit être revalidé à
# chaque visite, sinon un changement de prix mettrait un an à arriver.
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
